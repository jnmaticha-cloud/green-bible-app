# Green Bible App Environment Configuration
# Copy this file to .env and update with your actual values

# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=sqlite:./bible.db

# Authentication
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=7d

# API Keys (if needed for external services)
# API_KEY=your-api-key

# Pollinations AI (Bible interpretation, interlinear, semantic search, study guide, sermons)
# Create keys at https://enter.pollinations.ai — generation uses https://gen.pollinations.ai (see src/lib/pollinationsClient.ts)
# POLLINATIONS_API_KEY=sk_...
# Optional overrides:
# POLLINATIONS_API_BASE=https://gen.pollinations.ai
# POLLINATIONS_MODEL=mistral
# (Default: mistral. Use openai for GPT-4/Turbo, but requires sk_ key above)

# Email Configuration (for notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Caching
CACHE_TTL=3600

# Logging
LOG_LEVEL=info
